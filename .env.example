# ===== 应用 =====
ENV=dev
DEBUG=false
# 生产环境必须替换为至少 32 位随机值；可直接用：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please-change-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 数据库 =====
# 本地演示：SQLite；本地 MySQL：mysql+aiomysql://pojian:密码@127.0.0.1:3306/pojian?charset=utf8mb4
# Docker Compose：由下方 MYSQL_* 变量自动拼接，无需手写
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
AUTO_CREATE_TABLES=true

# ===== Docker Compose 专用（本地 python run.py 不读取）=====
MYSQL_DATABASE=pojian
MYSQL_USER=pojian
MYSQL_PASSWORD=please-change-db-password
MYSQL_ROOT_PASSWORD=please-change-root-password
# 宿主机端口映射；本机端口被占用时改这里
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
API_HOST_PORT=8080

# ===== 缓存 =====
CACHE_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=1800

# ===== LLM =====
# mock = 离线模板；deepseek = 真实模型（需填 API Key）
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=900

# ===== 向量化 =====
# hash = 离线特征哈希；bge-m3 = 本地 BGE-M3；http = OpenAI 兼容接口
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=512
EMBEDDING_MODEL_PATH=BAAI/bge-m3
EMBEDDING_HTTP_URL=
EMBEDDING_HTTP_API_KEY=
EMBEDDING_HTTP_MODEL=bge-m3

# ===== 向量库 =====
# memory = 本地 JSON 索引；milvus = 生产向量库
VECTOR_BACKEND=memory
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=pojian_kb

# ===== RAG 参数 =====
KB_DIR=knowledge
KB_INDEX_PATH=data/kb/index.json
RAG_TOP_K=4
RAG_MIN_SCORE=0.3
RAG_CHUNK_SIZE=320
RAG_CHUNK_OVERLAP=60
RAG_LEXICAL_WEIGHT=0.25

# ===== 业务参数 =====
HISTORY_WINDOW=10
FOLLOWUP_WINDOW_DAYS=7
TRAINING_MAX_HINT_LEVEL=2
SAFETY_LLM_CHECK=false

# ===== 语音识别（可选） =====
# disabled = 关闭（接口返回 503）；funasr = 本地模型；http = OpenAI Whisper 兼容接口
ASR_PROVIDER=disabled
ASR_MODEL=paraformer-zh
ASR_VAD_MODEL=
ASR_PUNC_MODEL=
ASR_DEVICE=cpu
ASR_LANGUAGE=zh
ASR_TIMEOUT_SECONDS=120
ASR_MAX_UPLOAD_MB=20
ASR_MAX_DURATION_SECONDS=120
ASR_TEMP_DIR=data/tmp/asr
ASR_HTTP_URL=
ASR_HTTP_API_KEY=
ASR_HTTP_MODEL=whisper-1
# 云端示例（硅基流动）：
# ASR_HTTP_URL=https://api.siliconflow.cn/v1/audio/transcriptions
# ASR_HTTP_MODEL=FunAudioLLM/SenseVoiceSmall
ASR_HTTP_TRUST_ENV=false

# ===== 语音合成（可选） =====
# disabled = 前端使用浏览器系统语音；siliconflow = CosyVoice2 云端音色
TTS_PROVIDER=disabled
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:diana
TTS_API_KEY=
TTS_BASE_URL=https://api.siliconflow.cn/v1/audio/speech
TTS_SPEED=1.0
TTS_MAX_CHARS=1500
TTS_TRUST_ENV=false
